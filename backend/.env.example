# Lokal (SQLite — Default, kein Eintrag nötig)
DATABASE_URL=sqlite+aiosqlite:///./kovacevic.db

# NAS (PostgreSQL — diese Zeile für Deployment aktivieren)
# DATABASE_URL=postgresql+asyncpg://kovacevic:passwort@nas-ip:5432/kovacevic

SECRET_KEY=change-me-in-production-min-32-chars

# WebApp-URL(s) für CORS (JSON-Array, pydantic-settings v2 erwartet dieses Format für list[str])
ALLOWED_ORIGINS=["http://localhost:3000"]

# Coolify-Deployment (kovacevic.xyz) — Subdomain-Schema: <app>-api.kovacevic.xyz
# ALLOWED_ORIGINS=["https://familio.kovacevic.xyz"]
