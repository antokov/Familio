# Backend API base URL — no trailing slash
# Dev default: http://localhost:8000 (used automatically when this var is unset)
# NAS example: http://192.168.1.100:8000
VITE_API_URL=http://localhost:8000

# Coolify-Deployment (kovacevic.xyz) — Subdomain-Schema: <app>.kovacevic.xyz / <app>-api.kovacevic.xyz
# Als Build Variable in Coolify setzen (nicht Runtime-Env — Vite backt den Wert beim Build ein)
# VITE_API_URL=https://familio-api.kovacevic.xyz
